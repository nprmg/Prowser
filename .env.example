# === Ключи (нужен хотя бы один; если указаны оба — второй станет запасным) ===
# Gemini — бесплатно: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek — платно, но очень дёшево: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Какой ИИ использовать: auto — Gemini, а при сбое/тормозах сразу DeepSeek; gemini — только Gemini;
# deepseek — только DeepSeek. Переключается и в окне программы.
LLM_PROVIDER=auto

# Простые команды («открой блокнот», «закрой хром», «громкость 30», «пауза», «который час»)
# выполнять мгновенно, без обращения к ИИ.
FAST_COMMANDS=true

# === Gemini ===
# Список моделей: https://ai.google.dev/gemini-api/docs/models
# gemini-3.5-flash-lite — самая быстрая, с большим бесплатным лимитом;
# gemini-3.8-flash — умнее, но медленнее, и бесплатных запросов в день у неё намного меньше.
GEMINI_MODEL=gemini-3.5-flash-lite
# Насколько модель «думает» перед ответом: minimal, low, medium, high. Меньше — быстрее.
# Если модель не поддерживает уровень (у 3.8-flash нет minimal), возьмётся следующий.
GEMINI_THINKING_LEVEL=minimal
# Сколько секунд ждать ответа Gemini, прежде чем переключиться на DeepSeek
GEMINI_TIMEOUT=20

# === DeepSeek ===
# deepseek-flash (V4.1 Flash) — быстрая и дешёвая; deepseek-v4-pro — дороже
DEEPSEEK_MODEL=deepseek-flash
# Режим размышлений: disabled — быстрые ответы (рекомендуется для голоса), enabled — умнее, но медленнее
DEEPSEEK_THINKING=disabled
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60

# Если Gemini недоступен в вашем регионе — укажите прокси (или включите VPN):
# HTTPS_PROXY=http://127.0.0.1:8080

# === Личность ===
ASSISTANT_NAME=Джарвис
USER_TITLE=сэр
# Слова-активаторы через запятую (так распознаватель может услышать «Джарвис»)
WAKE_WORDS=джарвис,jarvis,джервис,жарвис,джарвиз,дварвиз,дарвис,гарвис

# === Голос ===
# Язык распознавания речи
LANGUAGE=ru-RU
# edge — нейроголос Microsoft (нужен интернет), system — встроенный голос системы, off — без озвучки
TTS_ENGINE=edge
# Голоса: ru-RU-DmitryNeural (мужской), ru-RU-SvetlanaNeural (женский). Полный список: edge-tts --list-voices
TTS_VOICE=ru-RU-DmitryNeural
TTS_RATE=+5%
# Номер микрофона (python main.py --list-mics). Пусто — микрофон по умолчанию.
MIC_DEVICE=
# Максимальная длина одной фразы в секундах
PHRASE_TIME_LIMIT=15

# === Безопасность ===
# Спрашивать подтверждение перед выключением ПК, удалением файлов, командами терминала
CONFIRM_DANGEROUS=true
# Разрешить ассистенту выполнять команды в терминале (PowerShell/bash)
ALLOW_SHELL=true

# === Дополнительно ===
# Поиск в Google через Gemini (Grounding). На бесплатном тарифе недоступен.
ENABLE_GOOGLE_SEARCH=false
